# 后台必填：请为生产环境设置独立且足够强的值。
BLOG_ADMIN_PASSWORD=
BLOG_SESSION_SECRET=

# Supabase：服务端密钥仅用于服务端/迁移脚本，严禁使用 NEXT_PUBLIC_ 前缀或提交到 GitHub。
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# For older Supabase projects, SUPABASE_SERVICE_ROLE_KEY is also supported.

# 浏览器直传 Supabase Storage 使用；仅填写 anon/publishable 公钥，绝不可填写 service role/secret key。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 国内地址转坐标：高德开放平台 Web 服务 API Key，只在服务端使用，不要加 NEXT_PUBLIC_ 前缀。
AMAP_API_KEY=

# Optional: configure these three values to enable an OpenAI-compatible AI chat provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

