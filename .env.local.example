# 后台必填：请为生产环境设置独立且足够强的值。
BLOG_ADMIN_PASSWORD=
BLOG_SESSION_SECRET=

# 国内地址转坐标：高德开放平台 Web 服务 API Key，只在服务端使用，不要加 NEXT_PUBLIC_ 前缀。
AMAP_API_KEY=

# Optional: configure these three values to enable an OpenAI-compatible AI chat provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
